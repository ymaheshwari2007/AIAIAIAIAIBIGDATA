# Copy to .env (gitignored). Everything here is a local-dev default.
#   cp .env.example .env

# Container file ownership. macOS: 50000 is fine. Linux: set to `id -u`.
AIRFLOW_UID=50000

# Shared secret between Airflow's own components. Any string works locally.
AIRFLOW__API_AUTH__JWT_SECRET=local-dev-secret

# Web UI login -> http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
_AIRFLOW_WWW_USER_EMAIL=user@user.com

# Our app database (the `appdb` container, separate from Airflow's metadata db).
# From the host it's localhost:5433; inside compose it's host `appdb`.
DEPWATCH_DB_USER=depwatch
DEPWATCH_DB_PASSWORD=root
DEPWATCH_DB_NAME=depwatch
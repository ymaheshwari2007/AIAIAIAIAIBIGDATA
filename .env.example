# Copy to .env (gitignored). Everything here is a local-dev default.
#   cp .env.example .env

# Container file ownership. macOS: 50000 is fine. Linux: set to `id -u`.
AIRFLOW_UID=50000

# Shared secret between Airflow's own components. Any string works locally.
AIRFLOW__API_AUTH__JWT_SECRET=local-dev-secret

# Web UI login -> http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
_AIRFLOW_WWW_USER_EMAIL=user@user.com

# Our app database (the `appdb` container, separate from Airflow's metadata db).
# From the host it's localhost:5433; inside compose it's host `appdb`.
DEPWATCH_DB_USER=depwatch
DEPWATCH_DB_PASSWORD=root
DEPWATCH_DB_NAME=depwatch

# GitHub Advisory API token — lifts the rate limit from 60 to 5000 req/hr.
# Public data, so the token needs NO scopes. Paste YOUR OWN token here in .env
# (each teammate uses their own; .env never leaves your machine). Blank = unauthenticated.
GITHUB_TOKEN=

# MinIO (raw landing zone). Console -> http://localhost:9001. Password >= 8 chars.
# No endpoint here on purpose: host code defaults to localhost:9000; compose
# points the Airflow containers at minio:9000 when we wire the DAG.
DEPWATCH_MINIO_ACCESS_KEY=minioadmin
DEPWATCH_MINIO_SECRET_KEY=minioadmin
DEPWATCH_MINIO_BUCKET=raw-advisories